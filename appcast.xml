    <item>
      <title>Lagoon 1.0.3</title>
      <pubDate>Tue, 27 Oct 2026 11:36:15 +0000</pubDate>
      <sparkle:version>18</sparkle:version>
      <sparkle:shortVersionString>1.0.3</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Claude usage percentages now show even when your Claude Code sessions run in the Claude app: Lagoon renews the expired Claude Code login the same way Claude Code does. Spotify likes now sync reliably both ways. Right-click the island to show or hide the music widget.</p>]]></description>
